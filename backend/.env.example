# Optional: only needed for the /api/rewrite endpoint (bullet rewording).
# Get a key at https://aistudio.google.com/app/apikey — note this is a
# separate thing from the consumer "Gemini Pro/Advanced" subscription in the
# Gemini app; API keys are issued and billed independently of that plan.
GEMINI_API_KEY=

# Optional: which Gemini model /api/rewrite calls. Defaults to the free-tier
# gemini-3.5-flash-lite if unset. Set to gemini-3.5-pro (or another model
# your key has access to) if you specifically want Pro-quality rewrites.
# Google periodically retires old model ids ("no longer available to new
# users") -- if you get a 404, check https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite

# The deployed frontend origin, for CORS. Leave as localhost for local dev.
FRONTEND_ORIGIN=http://localhost:5173
